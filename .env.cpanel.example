# Clinic Flow on shared cPanel hosting (e.g. Afrihost) — copy to .env and fill in.
APP_NAME="Clinic Flow"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://drbusinessflow.com
CENTRAL_DOMAINS=drbusinessflow.com,www.drbusinessflow.com
PROVIDER_DOMAIN=drbusinessflow.com
WEBSITE_EMAIL=hello@drbusinessflow.com

# Databases: create these three in cPanel → MySQL Databases (names get the account prefix) and give the user ALL PRIVILEGES on each.
# The mysql driver works with MariaDB (the server here) and is what the tests cover.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=drbusinessflow_platform
DB_USERNAME=drbusinessflow_app
DB_PASSWORD=
HUB_DB_DATABASE=drbusinessflow_hub

# Practice databases are created through cPanel's API.
TENANCY_DB_MANAGER=cpanel
TENANT_DB_PREFIX=drbusinessflow_cf_
CPANEL_HOST=reseller148.aserv.co.za
CPANEL_USER=drbusinessflow
CPANEL_API_TOKEN=
CPANEL_DB_USER=drbusinessflow_app

# No Redis, queue workers or real-time server on shared hosting: database-backed, cron-driven, polling.
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Security
CLINICFLOW_REQUIRE_AUTHENTICATOR=true
CLINICFLOW_CSP_REPORT_ONLY=true
CLINICFLOW_VIRUS_SCAN=false

MAIL_MAILER=smtp
MAIL_HOST=mail.drbusinessflow.com
MAIL_PORT=465
MAIL_USERNAME=noreply@drbusinessflow.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@drbusinessflow.com
MAIL_FROM_NAME="${APP_NAME}"
