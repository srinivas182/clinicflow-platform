APP_NAME="Clinic Flow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Clinic Flow
CLINICFLOW_VERSION=0.69.0
CLINICFLOW_REGION=af-south-1
CENTRAL_DOMAINS=localhost,127.0.0.1,clinicflow.test
TENANT_DB_PREFIX=cf_provider_
PROVIDER_DOMAIN=clinicflow.test
PAYMENTS_ALLOW_FAKE=true
TENANCY_QUEUE_PROVISIONING=false
INERTIA_SSR_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Platform database (providers, subscriptions, platform users)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinicflow_platform
DB_USERNAME=clinicflow
DB_PASSWORD=

# Network Hub database (cross-provider identity, consents, e-scripts)
HUB_DB_DATABASE=clinicflow_hub

# Redis is required: cache tags and sessions must work inside provider databases
SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@clinicflow.co.za"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# clinicflow.co.za contact details
WEBSITE_EMAIL=hello@clinicflow.co.za
WEBSITE_PHONE=
WEBSITE_ADDRESS="South Africa"

# Real-time updates (Reverb). Set BROADCAST_CONNECTION=reverb in production (with queue workers running).
REVERB_APP_ID=clinicflow
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
